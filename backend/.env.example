# Copie este arquivo para ".env" e preencha com valores reais. O ".env" nunca é commitado.

# Segredo usado para assinar os tokens de login (JWT). Gere um valor aleatório longo.
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Banco de dados. SQLite local por padrão; no VPS pode virar postgresql://usuario:senha@host/banco
DATABASE_URL=sqlite:///./raviera.db

# Token de acesso da API do Meta (System User Token recomendado). Se deixar em branco,
# o backend responde com dados de demonstração em vez de consultar o Meta de verdade.
META_ACCESS_TOKEN=

# Token pessoal (de usuário), usado só nas contas listadas em CONTAS_TOKEN_PESSOAL
# (app/config.py) — as contas Jeep, que pertencem a um portfólio de fora do grupo e por isso
# não podem ser acessadas pelo token de sistema acima. Expira a cada ~60 dias: quando isso
# acontecer, gerar de novo no Explorador da API Graph e trocar por um de longa duração.
# Só as contas dessa lista param de sincronizar quando ele vence; as demais seguem normais.
META_ACCESS_TOKEN_PESSOAL=

# Credenciais da Google Ads API (deixe em branco pra rodar em modo demonstração).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Token que protege os webhooks do Followize/Dealer Space (ver /webhooks/followize/*).
# Gere um valor aleatório longo — é o que vai na URL cadastrada no painel deles como "?token=".
FOLLOWIZE_WEBHOOK_TOKEN=

# Mesma ideia, pro bloco de "Enviar Webhook" do bot da Letalk (ver /webhooks/letalk/*).
LETALK_WEBHOOK_TOKEN=

# Credenciais do primeiro usuário administrador, usadas só pelo script seed.py.
# Use um e-mail real (domínios como .local/.test são rejeitados na criação de outros usuários pela API).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
